{
  "name": "@lucaslobasso/js-logger",
  "version": "2.0.0",
  "description": "Tiny, zero-dependency browser error logger: runtime errors, rejected promises and failed requests, batched to your own endpoint.",
  "license": "MIT",
  "author": "Lucas Lobasso",
  "homepage": "https://github.com/lucaslobasso/js-logger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaslobasso/js-logger.git"
  },
  "bugs": "https://github.com/lucaslobasso/js-logger/issues",
  "keywords": [
    "logging",
    "logger",
    "error-tracking",
    "error-reporting",
    "error-handling",
    "self-hosted",
    "browser",
    "react",
    "vue",
    "angular"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/jsLogger.global.js",
  "jsdelivr": "./dist/jsLogger.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check": "npm run typecheck && npm test && npm run build && npm run size",
    "demo": "npm run build && node examples/node/server.mjs",
    "screenshots": "npm run build && node docs/screenshots.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@angular/core": ">=15",
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "core (ESM, min+brotli)",
      "path": "dist/index.js",
      "import": "{ init }",
      "limit": "3 KB"
    },
    {
      "name": "<script> build (min+brotli)",
      "path": "dist/jsLogger.global.js",
      "limit": "3.5 KB"
    }
  ],
  "devDependencies": {
    "@angular/core": "^22.2.6",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "rxjs": "^7.8.2",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
